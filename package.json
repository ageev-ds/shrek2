{
  "name": "shrek-path",
  "productName": "Путь Шрека",
  "version": "1.0.0",
  "description": "Путь Шрека — игра-бродилка с мини-играми ко дню рождения",
  "author": "ageev-ds",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,main,app \"vite\" \"node scripts/build-electron.mjs --watch\" \"wait-on tcp:5173 dist-electron/main.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "node scripts/build-electron.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/validate-assets.mjs",
    "icon": "node scripts/make-icon.mjs",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "build:portable": "npm run check && npm run build && node scripts/build-portable.mjs"
  },
  "devDependencies": {
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "esbuild": "^0.28.2",
    "framer-motion": "^13.4.6",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  }
}
